<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your chat</title>
</head>
<body>
    <p>Edit your chat : <%= chats._id %></p>
    <p>This chat was sent from <b><%= chats.from %></b> to <b><%= chats.to %></b></p>
    <form method="post" action="/chats/<%= chats.id %>?_method=PUT">
        <textarea name="msg" cols="40" rows="5"><%= chats.msg %></textarea> <br>
        <button>Submit</button>
    </form>
</body>
</html>