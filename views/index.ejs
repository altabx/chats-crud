<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Chats</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <h3>All Chats</h3>
    <form method="get" action="/chats/new">
        <button class="btn">New Chat</button>
    </form> <br>
    <% for (let chat of chats) { %>
        <div class="box">
            <p>
                From : <%= chat.from %>
            </p>
            <div class="contain">
                <p>
                    <%= chat.msg %>
                </p>
            </div>
            <p>
                <i> Recived by <%= chat.to %> </i>
            </p>
            <form method="get" action="/chats/<%= chat._id %>/edit">
                <button class="editbtn">Edit you Message</button>
            </form>
            <form method="post" action="/chats/<%= chat.id %>?_method=DELETE">
                <button class="dltmsg">Delete Message</button>
            </form>
            <hr>
            <p><%= chat.created_at.toString().split(" ")[4] %></p>
            <p><%= chat.created_at.toString().split(" ").slice(0,4).join("-") %></p>
        </div>
        <br> <br> 
        <% } %>
</body>

</html>